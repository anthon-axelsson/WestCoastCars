<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Client.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Client.Views.MainWindow"
        Title="WestCoast Cars Admin"
        Background="#020618"
        Foreground="White"
        Width="1024"
        Height="768">

        <Design.DataContext>
                <vm:MainWindowViewModel>

                </vm:MainWindowViewModel>
        </Design.DataContext>
    <Grid ColumnDefinitions="auto,*">
        <Border Background="#22227E" Padding="10" BorderBrush="White" BorderThickness="0 0 1 0">
        <Grid RowDefinitions="*,auto">
                <StackPanel Spacing="5">
                        <TextBlock Text="Admin"/>
                        <Button HorizontalAlignment="Stretch" Foreground="#ffffff" Background="#FF3939F0">Vehicle</Button>
                        <Button HorizontalAlignment="Stretch" Foreground="#ffffff" Background="#FF3939F0">Customers</Button>
                        <Button HorizontalAlignment="Stretch" Foreground="#ffffff" Background="#FF3939F0">Workshop</Button>
                        <Button HorizontalAlignment="Stretch" Foreground="#ffffff" Background="#FF3939F0">Service booking</Button>
                        <Button HorizontalAlignment="Stretch" Foreground="#ffffff" Background="#FF3939F0">Reserve parts</Button>                
                </StackPanel>
                <Button Grid.Row="1" HorizontalAlignment="Stretch" Foreground="#ffffff" Background="#FF3939F0">Settings</Button>
        </Grid>

        </Border>

        <UserControl Padding="20" Content="{Binding CurrentView}" Grid.Column="1"  />

        <!-- <StackPanel Grid.Column="1" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBox Text="{Binding Model}"></TextBox>
                <TextBlock Text="{Binding Manufacturer}" FontSize="30"/>
                <Button Command="{Binding SayHelloCommand}" Content="Change Name" Foreground="#ffffff" Background="#FF3939F0"/>
                <TextBlock Foreground="HotPink" FontSize="30"/>
        </StackPanel> -->
    </Grid>
</Window>

